def MAVEN_PARAMS = "-U -B -e -fae -V -Dnoassembly -Dmaven.compiler.fork=true -Dsurefire.rerunFailingTestsCount=2 -Dorg.nordix.namespace=true"

pipeline {

    agent {
        label "${params.AGENT_LABEL}"
    }

    tools {
        jdk "${params.JDK_NAME}"
    }

    environment {
        MAVEN_SKIP_RC = true
    }

    options {
        buildDiscarder(
            logRotator(artifactNumToKeepStr: '5', numToKeepStr: '10')
        )
        disableConcurrentBuilds()
    }

    parameters {
        booleanParam(name: 'CLEAN', defaultValue: true, description: 'Perform the build in clean workspace')
    }

    stages {

        stage('Clean workspace') {
             when {
                 expression { params.CLEAN }
             }
             steps {
                 sh 'git clean -fdx'
           }
        }

        stage('Build') {
            steps {
                sh "./mvnw $MAVEN_PARAMS -Dmaven.test.skip.exec=true clean install"
            }
        }

        stage('Checks') {
            steps {
                sh "./mvnw $MAVEN_PARAMS -pl :camel-buildtools install"
                sh "./mvnw $MAVEN_PARAMS -Psourcecheck -Dcheckstyle.failOnViolation=false checkstyle:check"
            }
        }

        stage('Deploy') {
            steps {
                withCredentials([string(credentialsId: 'MAVEN_TOKEN', variable: 'MAVEN_TOKEN')]) {
                    sh "./mvnw $MAVEN_PARAMS -DskipTests deploy -Dorg.nordix.maven.token=$MAVEN_TOKEN"
                }
            }
        }

    }

}

